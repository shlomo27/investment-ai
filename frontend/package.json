{
  "name": "investment-ai-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "icons": "node assets/build-icons.mjs && npx capacitor-assets generate --iconBackgroundColor #030712 --iconBackgroundColorDark #030712 --splashBackgroundColor #030712 --splashBackgroundColorDark #030712",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:ios": "npm run mobile:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8",
    "@capacitor/app": "^8",
    "@capacitor/core": "^8",
    "@capacitor/preferences": "^8",
    "@capacitor/push-notifications": "^8",
    "@capacitor/splash-screen": "^8",
    "@capacitor/status-bar": "^8",
    "@reduxjs/toolkit": "^2.2.3",
    "axios": "^1.7.2",
    "firebase": "^12.15.0",
    "lightweight-charts": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8",
    "@capacitor/ios": "^8",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
